//@version=6
strategy("Aurum Gold v6 - SNR + SND", shorttitle="Aurum v6", overlay=true, max_bars_back=2000, max_lines_count=100, max_boxes_count=60, max_labels_count=500, initial_capital=1000, currency=currency.USD, default_qty_type=strategy.fixed, commission_type=strategy.commission.cash_per_contract, commission_value=0.15, slippage=0, process_orders_on_close=true, calc_on_every_tick=true, margin_long=1, margin_short=1, pyramiding=0)

// =====================================================================
// AURUM GOLD v6 — simple supply/demand + support/resistance signals for XAUUSD
//
// BUY  = higher-timeframe trend UP
//        + price dips into a DEMAND zone (2 pts) and/or SUPPORT level (1 pt)
//        + the candle CLOSES back above it (bullish candle or long lower wick)
//        + the target (next resistance/supply) is at least "Minimum reward" x risk away
//        + the candle opened inside the chosen trading session (London / New York by default)
// SELL = the mirror image.
// One trade at a time. The trade closes at TP (+R), SL (-1R) or after 100 candles.
// Every closed trade goes into the RECORD row, which is a built-in backtest of the rules.
//
// ALL-IN-ONE: this is a TradingView *strategy*, so one script gives both the trading panel and the
// Strategy Tester report (net profit, drawdown, profit factor). It does not place real orders.
// Backtest cost: commission 0.15 per oz on entry and exit (about 0.30 spread per trade);
// change it in Settings > Properties > Commission. Made for spot XAUUSD (1 contract = 1 oz).
//
// Signals are decided on CLOSED candles only, so a printed signal does not disappear.
// calc_on_every_tick=true only keeps the panel and zones live on the forming candle; all trading
// decisions and orders still happen at the candle close (barstate.isconfirmed).
// Shared rules with MT5: mt5/AurumCore.mqh. Demo research — not a guaranteed strategy.
// =====================================================================

// ---------- 1. Signals ----------
string modeInput = input.string("Balanced", "Signal mode", options=["Balanced", "Strict", "Aggressive"], display=display.none, group="1. Signals", tooltip="Aggressive: any demand/supply zone or S/R level (most signals).\nBalanced: price must be in a demand/supply zone (recommended).\nStrict: zone AND S/R level together (fewest, strongest).\nAll modes trade only with the trend.")
string sessionInput = input.string("London + New York", "Trading sessions", options=["London + New York", "London only", "New York only", "All day"], display=display.none, group="1. Signals", tooltip="New trades only when the signal candle opens in this session. Open trades are always followed.\nLondon 08:00-17:00 London time = 15:00/16:00 to 00:00/01:00 Malaysia time.\nNew York 08:00-17:00 New York time = 20:00/21:00 to 05:00/06:00 Malaysia time.\nDaylight saving is handled automatically. Ignored on 4H and higher charts.")
string swingInput = input.string("Normal", "Swing size", options=["Small", "Normal", "Large"], display=display.none, group="1. Signals", tooltip="How big a swing must be to make an S/R level.\nSmall = more levels (scalping). Large = only major levels.")
string htfInput = input.timeframe("", "Trend timeframe (empty = auto)", display=display.none, group="1. Signals", tooltip="Auto: 1m→15m, 5m→1H, 15m-1H→4H, 2H-4H→1D, 1D→1W.")
float minRR = input.float(1.5, "Minimum reward (× risk)", minval=1.0, maxval=5, step=0.1, display=display.none, group="1. Signals", tooltip="Skip a setup when the next opposite zone/level is closer than this.\n1.5 means you must be able to win at least 1.5x what you risk.")

// ---------- 2. Risk ----------
float balance = input.float(1000, "Account balance ($)", minval=1, display=display.none, group="2. Risk", tooltip="Used for the LOT SIZE on the panel.\nThe backtest uses Settings > Properties > Initial capital instead.")
float riskPct = input.float(1.0, "Risk per trade (%)", minval=0.1, maxval=10, step=0.1, display=display.none, group="2. Risk", tooltip="Lot size on the panel, and position size in the backtest (% of current equity).")

// ---------- 3. Display ----------
bool showAll = input.bool(false, "Show all nearby zones and levels", display=display.none, group="3. Display", tooltip="Off: only the nearest area above and below price (clean chart).")
bool showHistory = input.bool(true, "Show past signals and results", display=display.none, group="3. Display")
string panelCorner = input.string("Top right", "Panel position", options=["Top right", "Bottom right", "Top left", "Bottom left"], display=display.none, group="3. Display")

// ---------- 4. Advanced (defaults are fine) ----------
float impulseATR = input.float(1.5, "Zone impulse: candle body ≥ ATR ×", minval=0.5, maxval=5, step=0.1, display=display.none, group="4. Advanced")
float slBufferATR = input.float(0.2, "Stop-loss buffer beyond the area (ATR ×)", minval=0, maxval=2, step=0.05, display=display.none, group="4. Advanced")
float minRiskATR = input.float(0.5, "Minimum stop-loss distance (ATR ×)", minval=0.1, maxval=5, step=0.05, display=display.none, group="4. Advanced")
int maxItems = input.int(4, "Max zones / levels kept per side", minval=1, maxval=10, display=display.none, group="4. Advanced")
int atrLength = input.int(14, "ATR period", minval=2, maxval=200, display=display.none, group="4. Advanced")
int maxBars = input.int(100, "Close a trade after (candles)", minval=5, maxval=500, display=display.none, group="4. Advanced")
float contractSize = input.float(100, "Contract size (oz per 1 lot)", minval=1, display=display.none, group="4. Advanced", tooltip="XAUUSD standard lot = 100 oz on most brokers. Check yours.")

// ---------- Indicator helpers ----------
f_lots(float entry, float stop) =>
    float dist = math.abs(entry - stop)
    dist > 0 ? math.floor(balance * riskPct / 100 / (dist * contractSize) * 100 + 1e-9) / 100.0 : 0.0

f_grade(int g) => g == 0 ? "A" : g == 1 ? "B" : "C"

f_price(float p) => na(p) ? "--" : str.tostring(p, format.mintick)
f_r(float r) => (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R"
f_money(float m) => "$" + str.tostring(m, "#,##0.##")
f_tf(string tf) =>
    float n = str.tonumber(tf)
    na(n) ? (str.length(tf) == 1 ? "1" + tf : tf) : n >= 60 and n % 60 == 0 ? str.tostring(n / 60, "#") + "H" : tf + "m"

// ---------- Trade state and record (indicator only) ----------
var bool inTrade = false
var int tDir = 0
var int tBar = na
var int tScore = 0
var float tEntry = na
var float tSL = na
var float tTP = na
var string tWhy = ""
var int tQuality = 0
var int tGrade = 2
// Record per grade (A, B, C): used for the WIN CHANCE of a new signal
var array<int> gradeTrades = array.from(0, 0, 0)
var array<int> gradeWins = array.from(0, 0, 0)
// Record of closed trades (R multiples) — the built-in backtest
var array<float> results = array.new<float>()
var int lastDir = 0
var int lastExitBar = na
var float lastR = na
var string lastHow = ""

// ---------- 0) Follow the open trade: SL / TP / time limit ----------
float closedR = na
if barstate.isconfirmed and inTrade and bar_index > tBar
    float risk = math.abs(tEntry - tSL)
    bool slHit = tDir > 0 ? low <= tSL : high >= tSL
    bool tpHit = tDir > 0 ? high >= tTP : low <= tTP
    // Stop loss first: a candle touching both SL and TP counts as a LOSS (conservative)
    if slHit
        closedR := -1.0
        lastHow := "SL"
    else if tpHit
        closedR := math.abs(tTP - tEntry) / risk
        lastHow := "TP"
    else if bar_index - tBar >= maxBars
        closedR := (close - tEntry) * tDir / risk
        lastHow := "Time exit"
        strategy.close_all(comment="Time exit")
    if not na(closedR)
        inTrade := false
        array.push(results, closedR)
        array.set(gradeTrades, tGrade, array.get(gradeTrades, tGrade) + 1)
        array.set(gradeWins, tGrade, array.get(gradeWins, tGrade) + (closedR > 0 ? 1 : 0))
        lastDir := tDir
        lastExitBar := bar_index
        lastR := closedR
        if showHistory
            color rc = closedR > 0 ? color.teal : closedR < 0 ? color.red : color.gray
            label.new(bar_index, tDir > 0 ? high : low, lastHow + " " + f_r(closedR), yloc=tDir > 0 ? yloc.abovebar : yloc.belowbar, style=label.style_none, textcolor=rc, size=size.small)

// No new trade on the candle where the time limit closed a trade (same rule in MT5 and the model)
bool canOpen = not inTrade and not (not na(closedR) and lastHow == "Time exit")

// ===================== RULES START =====================
// The trading rules (same as mt5/AurumCore.mqh). Needs the inputs and `canOpen`.
// Fixed rule constants (same values as mt5/AurumCore.mqh)
float TOUCH_ATR = 0.2      // how close counts as "touching" an area
float MERGE_ATR = 0.3      // S/R levels closer than this are merged

int pivotLen = swingInput == "Small" ? 3 : swingInput == "Large" ? 10 : 5
int tfSec = timeframe.in_seconds()
string autoHTF = tfSec <= 60 ? "15" : tfSec <= 300 ? "60" : tfSec <= 3600 ? "240" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : "M"
string htf = htfInput == "" ? autoHTF : htfInput

// ---------- Market data ----------
float atrNow = ta.atr(atrLength)
float atrPrev = atrNow[1]          // previous candle's ATR: a big candle cannot inflate its own limits
float ema200 = ta.ema(close, 200)
// Completed higher-timeframe candle only ([1] + lookahead_on): no repainting.
[htfClose, htfEMA] = request.security(syminfo.tickerid, htf, [close[1], ta.ema(close, 200)[1]], lookahead=barmerge.lookahead_on)
int trendDir = not na(htfClose) and not na(htfEMA) ? (htfClose > htfEMA ? 1 : htfClose < htfEMA ? -1 : 0) : not na(ema200) ? (close > ema200 ? 1 : close < ema200 ? -1 : 0) : 0
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
bool ready = not na(atrPrev) and atrPrev > 0 and bar_index > pivotLen * 2 + atrLength

// ---------- Trading sessions (candle open time; same rule as AurumSessionAllowed) ----------
bool inLondon = not na(time(timeframe.period, "0800-1700:23456", "Europe/London"))
bool inNewYork = not na(time(timeframe.period, "0800-1700:23456", "America/New_York"))
bool sessionFilterOn = sessionInput != "All day" and tfSec < 14400
bool sessionOK = not sessionFilterOn or (sessionInput == "London only" ? inLondon : sessionInput == "New York only" ? inNewYork : inLondon or inNewYork)

// ---------- Helpers ----------
f_bullRejection(float o, float h, float l, float c) =>
    float rng = h - l
    bool result = false
    if rng > 0
        result := c > o or (math.min(o, c) - l >= 0.5 * rng and c >= l + 0.5 * rng)
    result

f_bearRejection(float o, float h, float l, float c) =>
    float rng = h - l
    bool result = false
    if rng > 0
        result := c < o or (h - math.max(o, c) >= 0.5 * rng and c <= h - 0.5 * rng)
    result

// Add an S/R level, replacing any level within tol, keeping at most cap levels.
f_addLevel(array<float> prices, array<int> bars, float price, int barIdx, float tol, int cap) =>
    if array.size(prices) > 0
        for i = array.size(prices) - 1 to 0
            if math.abs(array.get(prices, i) - price) <= tol
                array.remove(prices, i)
                array.remove(bars, i)
    array.push(prices, price)
    array.push(bars, barIdx)
    while array.size(prices) > cap
        array.shift(prices)
        array.shift(bars)
    0

// Add a zone, replacing overlapping zones, keeping at most cap zones.
f_addZone(array<float> tops, array<float> bots, array<int> bars, array<int> touches, float top, float bot, int barIdx, int cap) =>
    if array.size(tops) > 0
        for i = array.size(tops) - 1 to 0
            if array.get(bots, i) <= top and array.get(tops, i) >= bot
                array.remove(tops, i)
                array.remove(bots, i)
                array.remove(bars, i)
                array.remove(touches, i)
    array.push(tops, top)
    array.push(bots, bot)
    array.push(bars, barIdx)
    array.push(touches, 0)
    while array.size(tops) > cap
        array.shift(tops)
        array.shift(bots)
        array.shift(bars)
        array.shift(touches)
    0

// Target = next opposite area, capped at max(3, minRR) R; none -> max(2, minRR) R.
// Returns na when that area is closer than minRR (not worth the risk). Same as AurumTarget().
f_target(int dir, float entry, float stop, float nearest) =>
    float risk = math.abs(entry - stop)
    float tp = na
    if risk > 0
        if not na(nearest) and (nearest - entry) * dir > 0
            float rr = (nearest - entry) * dir / risk
            tp := rr >= minRR ? entry + dir * math.min(rr, math.max(3.0, minRR)) * risk : na
        else
            tp := entry + dir * math.max(2.0, minRR) * risk
    tp

// Lot size rounded DOWN to 0.01. Same as AurumLots().
// ---------- Area state (updated only on CLOSED candles) ----------
var array<float> resP = array.new<float>()
var array<int> resB = array.new<int>()
var array<float> supP = array.new<float>()
var array<int> supB = array.new<int>()
var array<float> dTop = array.new<float>()
var array<float> dBot = array.new<float>()
var array<int> dBar = array.new<int>()
var array<int> dTouch = array.new<int>()     // how many candles have entered each demand zone
var array<float> sTop = array.new<float>()
var array<float> sBot = array.new<float>()
var array<int> sBar = array.new<int>()
var array<int> sTouch = array.new<int>()
var int skipBar = na
var string skipText = ""
// Diagnostics: every setup (a rejection candle at any zone or level) and the FIRST rule that stopped it.
// Same counting as mt5/AurumConfirmation.mq5 and tradingview/tests/model.py.
var int setupCount = 0
var int blockWeak = 0       // area worth fewer points than the mode needs
var int blockTrend = 0      // against the higher-timeframe trend (or trend flat)
var int blockBusy = 0       // a trade was already open
var int blockSession = 0    // outside the trading session
var int blockTarget = 0     // next opposite area closer than the minimum reward
var int tradedCount = 0
var int firstBarTime = na
firstBarTime := na(firstBarTime) ? time : firstBarTime

// ---------- 1) Evaluate this closed candle against EXISTING areas ----------
// Outputs: a new trade for this candle (newDir 1 BUY, -1 SELL, 0 none)
int newDir = 0
float newEntry = na
float newSL = na
float newTP = na
int newScore = 0
string newWhy = ""
int newQuality = 0          // 0-100, see AurumQuality()
int newGrade = 2            // 0 = A, 1 = B, 2 = C
if barstate.isconfirmed and ready
    float tol = TOUCH_ATR * atrPrev
    // SND
    bool inDemand = false
    bool demandFresh = false
    float demandLow = na
    for [i, top] in dTop
        float bot = array.get(dBot, i)
        if top > bot and low <= top + tol and close > top
            inDemand := true
            demandLow := na(demandLow) ? bot : math.min(demandLow, bot)
            demandFresh := demandFresh or array.get(dTouch, i) == 0
    bool inSupply = false
    bool supplyFresh = false
    float supplyHigh = na
    for [i, bot] in sBot
        float top = array.get(sTop, i)
        if top > bot and high >= bot - tol and close < bot
            inSupply := true
            supplyHigh := na(supplyHigh) ? top : math.max(supplyHigh, top)
            supplyFresh := supplyFresh or array.get(sTouch, i) == 0
    // SNR
    bool atSupport = false
    float supportLow = na
    for p in supP
        if low <= p + tol and close > p
            atSupport := true
            supportLow := na(supportLow) ? p : math.min(supportLow, p)
    bool atResistance = false
    float resistanceHigh = na
    for p in resP
        if high >= p - tol and close < p
            atResistance := true
            resistanceHigh := na(resistanceHigh) ? p : math.max(resistanceHigh, p)

    // Points: a supply/demand zone counts double
    int buyScore = (inDemand ? 2 : 0) + (atSupport ? 1 : 0)
    int sellScore = (inSupply ? 2 : 0) + (atResistance ? 1 : 0)
    int need = modeInput == "Strict" ? 3 : modeInput == "Aggressive" ? 1 : 2
    bool buyRej = f_bullRejection(open, high, low, close)
    bool sellRej = f_bearRejection(open, high, low, close)
    bool buyRaw = buyRej and buyScore >= need and trendDir > 0
    bool sellRaw = sellRej and sellScore >= need and trendDir < 0
    // Diagnostics for setups stopped before the session / target checks
    for side = 0 to 1
        bool setup = side == 0 ? buyRej and buyScore >= 1 : sellRej and sellScore >= 1
        if setup
            int score = side == 0 ? buyScore : sellScore
            bool withTrend = side == 0 ? trendDir > 0 : trendDir < 0
            setupCount += 1
            if score < need
                blockWeak += 1
            else if not withTrend
                blockTrend += 1
            else if not canOpen
                blockBusy += 1

    if (buyRaw or sellRaw) and not (buyRaw and sellRaw) and canOpen    // one trade at a time
        int dir = buyRaw ? 1 : -1
        float entry = close
        float sl = na
        float nearest = na
        if dir > 0
            float structure = low
            structure := inDemand ? math.min(structure, demandLow) : structure
            structure := atSupport ? math.min(structure, supportLow) : structure
            sl := math.min(structure - slBufferATR * atrPrev, entry - minRiskATR * atrPrev)
            for p in resP
                if p > entry
                    nearest := na(nearest) ? p : math.min(nearest, p)
            for p in sBot
                if p > entry
                    nearest := na(nearest) ? p : math.min(nearest, p)
        else
            float structure = high
            structure := inSupply ? math.max(structure, supplyHigh) : structure
            structure := atResistance ? math.max(structure, resistanceHigh) : structure
            sl := math.max(structure + slBufferATR * atrPrev, entry + minRiskATR * atrPrev)
            for p in supP
                if p < entry
                    nearest := na(nearest) ? p : math.max(nearest, p)
            for p in dTop
                if p < entry
                    nearest := na(nearest) ? p : math.max(nearest, p)
        float tp = f_target(dir, entry, sl, nearest)
        string why = dir > 0 ? str.trim((inDemand ? "Demand " : "") + (atSupport ? "Support" : "")) : str.trim((inSupply ? "Supply " : "") + (atResistance ? "Resistance" : ""))
        if not sessionOK
            blockSession += 1
            skipBar := bar_index
            skipText := (dir > 0 ? "BUY" : "SELL") + " setup skipped: outside " + sessionInput
        else if na(tp)
            blockTarget += 1
            skipBar := bar_index
            skipText := (dir > 0 ? "BUY" : "SELL") + " skipped: target only " + str.tostring(math.abs(nearest - entry) / math.abs(entry - sl), "#.#") + "R away"
        else
            tradedCount += 1
            newDir := dir
            newEntry := entry
            newSL := sl
            newTP := tp
            newScore := dir > 0 ? buyScore : sellScore
            newWhy := why
            // Quality (information only): same as AurumQuality() / AurumGrade()
            bool zoneHit = dir > 0 ? inDemand : inSupply
            bool levelHit = dir > 0 ? atSupport : atResistance
            bool fresh = dir > 0 ? demandFresh : supplyFresh
            float rr = math.abs(tp - entry) / math.abs(entry - sl)
            int q = zoneHit and levelHit ? 35 : zoneHit ? 25 : levelHit ? 10 : 0
            q += zoneHit and fresh ? 20 : 0
            q += rr >= 2.5 ? 25 : rr >= 2.0 ? 20 : rr >= 1.5 ? 12 : 5
            q += inLondon and inNewYork ? 20 : inLondon or inNewYork ? 12 : 0
            newQuality := q
            newGrade := q >= 70 ? 0 : q >= 50 ? 1 : 2
            newWhy := why + (zoneHit and fresh ? " (fresh)" : "")

// ---------- 2) Update areas with this closed candle ----------
if barstate.isconfirmed and ready
    float mergeTol = MERGE_ATR * atrPrev
    float touchTol = TOUCH_ATR * atrPrev
    // Count every candle that enters a zone (a zone is "fresh" until its first touch)
    for [i, top] in dTop
        if low <= top + touchTol
            array.set(dTouch, i, array.get(dTouch, i) + 1)
    for [i, bot] in sBot
        if high >= bot - touchTol
            array.set(sTouch, i, array.get(sTouch, i) + 1)
    // Zones die when a candle CLOSES through them
    if array.size(dTop) > 0
        for i = array.size(dTop) - 1 to 0
            if close < array.get(dBot, i)
                array.remove(dTop, i)
                array.remove(dBot, i)
                array.remove(dBar, i)
                array.remove(dTouch, i)
    if array.size(sTop) > 0
        for i = array.size(sTop) - 1 to 0
            if close > array.get(sTop, i)
                array.remove(sTop, i)
                array.remove(sBot, i)
                array.remove(sBar, i)
                array.remove(sTouch, i)
    // SNR role flip: broken resistance becomes support and vice versa
    array<float> toSup = array.new<float>()
    array<int> toSupBar = array.new<int>()
    array<float> toRes = array.new<float>()
    array<int> toResBar = array.new<int>()
    if array.size(resP) > 0
        for i = array.size(resP) - 1 to 0
            if close > array.get(resP, i)
                array.push(toSup, array.get(resP, i))
                array.push(toSupBar, array.get(resB, i))
                array.remove(resP, i)
                array.remove(resB, i)
    if array.size(supP) > 0
        for i = array.size(supP) - 1 to 0
            if close < array.get(supP, i)
                array.push(toRes, array.get(supP, i))
                array.push(toResBar, array.get(supB, i))
                array.remove(supP, i)
                array.remove(supB, i)
    for [i, p] in toSup
        f_addLevel(supP, supB, p, array.get(toSupBar, i), mergeTol, maxItems)
    for [i, p] in toRes
        f_addLevel(resP, resB, p, array.get(toResBar, i), mergeTol, maxItems)
    // New SND zone from this candle (previous candle = base)
    if close - open >= impulseATR * atrPrev and close > high[1]
        float bot = math.min(low[1], low)
        float top = math.max(open[1], close[1])
        top := top - bot < 0.2 * atrPrev ? bot + 0.2 * atrPrev : top
        if top - bot <= 2.0 * atrPrev and top < close
            f_addZone(dTop, dBot, dBar, dTouch, top, bot, bar_index - 1, maxItems)
    if open - close >= impulseATR * atrPrev and close < low[1]
        float top = math.max(high[1], high)
        float bot = math.min(open[1], close[1])
        bot := top - bot < 0.2 * atrPrev ? top - 0.2 * atrPrev : bot
        if top - bot <= 2.0 * atrPrev and bot > close
            f_addZone(sTop, sBot, sBar, sTouch, top, bot, bar_index - 1, maxItems)
    // New SNR levels from confirmed swing points
    if not na(ph)
        if close < ph
            f_addLevel(resP, resB, ph, bar_index - pivotLen, mergeTol, maxItems)
        else
            f_addLevel(supP, supB, ph, bar_index - pivotLen, mergeTol, maxItems)
    if not na(pl)
        if close > pl
            f_addLevel(supP, supB, pl, bar_index - pivotLen, mergeTol, maxItems)
        else
            f_addLevel(resP, resB, pl, bar_index - pivotLen, mergeTol, maxItems)

// ===================== RULES END =====================

// ---------- Open the new trade, mark it and alert (indicator only) ----------
bool buySignal = newDir > 0
bool sellSignal = newDir < 0
if newDir != 0
    inTrade := true
    tDir := newDir
    tBar := bar_index
    tScore := newScore
    tEntry := newEntry
    tSL := newSL
    tTP := newTP
    tWhy := newWhy
    tQuality := newQuality
    tGrade := newGrade
    float rr = math.abs(newTP - newEntry) / math.abs(newEntry - newSL)
    float lot = f_lots(newEntry, newSL)
    string side = (newDir > 0 ? "BUY " : "SELL ") + f_grade(newGrade)
    string plan = "Quality " + f_grade(newGrade) + " (" + str.tostring(newQuality) + "/100)\nEntry " + f_price(newEntry) + "\nSL " + f_price(newSL) + "  (-" + str.tostring(riskPct) + "%)\nTP " + f_price(newTP) + "  (+" + str.tostring(rr * riskPct, "#.#") + "%)\nRR 1 : " + str.tostring(rr, "#.#") + "\nWhy: " + newWhy
    if showHistory
        if newDir > 0
            label.new(bar_index, low, side, yloc=yloc.belowbar, style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.small, tooltip=plan)
        else
            label.new(bar_index, high, side, yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small, tooltip=plan)
    // Backtest order: same entry, stop and target as the panel; size = risk % of equity
    string orderId = newDir > 0 ? "BUY" : "SELL"
    float qty = strategy.equity * riskPct / 100 / (math.abs(newEntry - newSL) * syminfo.pointvalue)
    strategy.entry(orderId, newDir > 0 ? strategy.long : strategy.short, qty=qty, comment=orderId)
    strategy.exit("Exit " + orderId, from_entry=orderId, stop=newSL, limit=newTP, comment_loss="SL", comment_profit="TP")
    alert("Aurum " + (newDir > 0 ? "BUY" : "SELL") + " " + syminfo.ticker + " " + f_tf(timeframe.period) + " | Quality " + f_grade(newGrade) + " " + str.tostring(newQuality) + "/100 | Entry " + f_price(newEntry) + " | SL " + f_price(newSL) + " | TP " + f_price(newTP) + " | RR 1:" + str.tostring(rr, "#.#") + " = +" + str.tostring(rr * riskPct, "#.#") + "% if TP | Lot " + str.tostring(lot, "#.##") + " | " + newWhy, alert.freq_once_per_bar_close)

// ---------- Data window (for checking / exporting results) and alerts ----------
plot(buySignal ? 1 : sellSignal ? -1 : 0, "Signal: BUY=1 SELL=-1", display=display.data_window)
plot(closedR, "Trade result (R)", display=display.data_window)
plot(trendDir, "Trend: UP=1 DOWN=-1", display=display.data_window)
bgcolor(sessionFilterOn and not sessionOK ? color.new(color.gray, 94) : na, title="Outside trading session")

// ---------- Nearest areas ----------
// Nearest SELL area above price: supply zone or resistance. Returns [kind, top, bottom, startBar];
// kind 0 = none, 1 = zone, 2 = level.
f_areaAbove() =>
    int kind = 0
    float top = na
    float bot = na
    int start = na
    float best = na
    for [i, t] in sTop
        float b = array.get(sBot, i)
        float d = math.max(0, b - close)
        if t >= close and (na(best) or d < best)
            best := d
            kind := 1
            top := t
            bot := b
            start := array.get(sBar, i)
    for [i, p] in resP
        float d = p - close
        if d > 0 and (na(best) or d < best)
            best := d
            kind := 2
            top := p
            bot := p
            start := array.get(resB, i)
    [kind, top, bot, start]

// Nearest BUY area below price: demand zone or support.
f_areaBelow() =>
    int kind = 0
    float top = na
    float bot = na
    int start = na
    float best = na
    for [i, t] in dTop
        float b = array.get(dBot, i)
        float d = math.max(0, close - t)
        if b <= close and (na(best) or d < best)
            best := d
            kind := 1
            top := t
            bot := b
            start := array.get(dBar, i)
    for [i, p] in supP
        float d = close - p
        if d > 0 and (na(best) or d < best)
            best := d
            kind := 2
            top := p
            bot := p
            start := array.get(supB, i)
    [kind, top, bot, start]

f_areaText(int kind, float top, float bot, bool above) =>
    kind == 1 ? (above ? "Supply " : "Demand ") + f_price(bot) + " – " + f_price(top) : kind == 2 ? (above ? "Resistance " : "Support ") + f_price(top) : "none nearby"

// ---------- Drawings (rebuilt on the last bar only) ----------
var array<line> drawLines = array.new<line>()
var array<box> drawBoxes = array.new<box>()
var array<label> drawLabels = array.new<label>()
color BUY_COLOR = color.teal
color SELL_COLOR = color.red

f_drawZone(int start, float top, float bot, int rightX, bool supply) =>
    color c = supply ? SELL_COLOR : BUY_COLOR
    array.push(drawBoxes, box.new(start, top, rightX, bot, border_color=color.new(c, 40), bgcolor=color.new(c, 82), text=supply ? "Supply" : "Demand", text_size=size.tiny, text_color=c, text_halign=text.align_right))

f_drawLevel(int start, float p, int rightX, bool resistance) =>
    color c = resistance ? SELL_COLOR : BUY_COLOR
    array.push(drawLines, line.new(start, p, rightX, p, color=color.new(c, 20), width=1, style=line.style_dashed))
    array.push(drawLabels, label.new(rightX, p, (resistance ? "R " : "S ") + f_price(p), style=label.style_label_left, color=color.new(c, 30), textcolor=color.white, size=size.tiny))

if barstate.islast
    for item in drawLines
        line.delete(item)
    for item in drawBoxes
        box.delete(item)
    for item in drawLabels
        label.delete(item)
    array.clear(drawLines)
    array.clear(drawBoxes)
    array.clear(drawLabels)
    int rightX = bar_index + 12
    if showAll
        // Everything within 8 ATR of price, on the correct side of price
        float range8 = 8 * nz(atrNow, 0)
        for [i, top] in dTop
            float bot = array.get(dBot, i)
            if bot <= close and close - top <= range8
                f_drawZone(array.get(dBar, i), top, bot, rightX, false)
        for [i, top] in sTop
            float bot = array.get(sBot, i)
            if top >= close and bot - close <= range8
                f_drawZone(array.get(sBar, i), top, bot, rightX, true)
        for [i, p] in supP
            if p < close and close - p <= range8
                f_drawLevel(array.get(supB, i), p, rightX, false)
        for [i, p] in resP
            if p > close and p - close <= range8
                f_drawLevel(array.get(resB, i), p, rightX, true)
    else
        // Clean chart: only the nearest area above and the nearest area below
        [kA, tA, bA, sA] = f_areaAbove()
        [kB, tB, bB, sB] = f_areaBelow()
        if kA == 1
            f_drawZone(sA, tA, bA, rightX, true)
        else if kA == 2
            f_drawLevel(sA, tA, rightX, true)
        if kB == 1
            f_drawZone(sB, tB, bB, rightX, false)
        else if kB == 2
            f_drawLevel(sB, tB, rightX, false)
    // Open trade: red risk box and green reward box, like TradingView's position tool
    if inTrade
        int x2 = bar_index + 6
        array.push(drawBoxes, box.new(tBar, math.max(tEntry, tSL), x2, math.min(tEntry, tSL), border_color=color.new(SELL_COLOR, 60), bgcolor=color.new(SELL_COLOR, 85)))
        array.push(drawBoxes, box.new(tBar, math.max(tEntry, tTP), x2, math.min(tEntry, tTP), border_color=color.new(BUY_COLOR, 60), bgcolor=color.new(BUY_COLOR, 85)))
        array.push(drawLabels, label.new(x2, tTP, "TP " + f_price(tTP), style=label.style_label_left, color=BUY_COLOR, textcolor=color.white, size=size.tiny))
        array.push(drawLabels, label.new(x2, tEntry, (tDir > 0 ? "BUY " : "SELL ") + f_price(tEntry), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.tiny))
        array.push(drawLabels, label.new(x2, tSL, "SL " + f_price(tSL), style=label.style_label_left, color=SELL_COLOR, textcolor=color.white, size=size.tiny))

// ---------- Panel ----------
string panelPosition = switch panelCorner
    "Top left" => position.top_left
    "Bottom left" => position.bottom_left
    "Bottom right" => position.bottom_right
    => position.top_right
var table panel = table.new(panelPosition, 2, 13, bgcolor=color.new(chart.bg_color, 5), frame_color=color.gray, frame_width=1, border_color=color.new(color.gray, 70), border_width=1)
f_row(int row, string name, string value, color valueColor) =>
    table.cell(panel, 0, row, name, text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, row, value, text_color=valueColor, text_size=size.small, text_halign=text.align_left)

if barstate.islast
    table.clear(panel, 0, 0, 1, 12)
    color fg = chart.fg_color
    // Header and trend
    table.cell(panel, 0, 0, "AURUM GOLD", text_color=color.orange, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 0, syminfo.ticker + " " + f_tf(timeframe.period) + "  ·  trend " + f_tf(htf), text_color=fg, text_size=size.small, text_halign=text.align_left)
    string trendText = trendDir > 0 ? "UP ▲   only BUY" : trendDir < 0 ? "DOWN ▼   only SELL" : "FLAT   no trades"
    f_row(1, "TREND", trendText, trendDir > 0 ? BUY_COLOR : trendDir < 0 ? SELL_COLOR : color.gray)
    string nowSession = inLondon and inNewYork ? "London + New York" : inLondon ? "London" : inNewYork ? "New York" : "Asia / off-hours"
    string sessionText = not sessionFilterOn ? nowSession + "   (filter off)" : sessionOK ? nowSession + "   ✓ trading" : nowSession + "   ✗ no new trades"
    f_row(2, "SESSION", sessionText, not sessionFilterOn ? fg : sessionOK ? BUY_COLOR : color.orange)
    // Status: the one thing to look at
    int age = inTrade ? bar_index - tBar : na
    string status = inTrade ? (age <= 1 ? (tDir > 0 ? "BUY NOW" : "SELL NOW") : (tDir > 0 ? "IN BUY TRADE" : "IN SELL TRADE")) : "WAIT"
    color statusBg = inTrade ? (tDir > 0 ? BUY_COLOR : SELL_COLOR) : color.gray
    table.cell(panel, 0, 3, "STATUS", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 3, status, text_color=color.white, bgcolor=statusBg, text_size=size.large, text_halign=text.align_center)
    if inTrade
        float risk = math.abs(tEntry - tSL)
        float rr = math.abs(tTP - tEntry) / risk
        float lot = f_lots(tEntry, tSL)
        float riskMoney = balance * riskPct / 100
        f_row(4, "ENTRY", f_price(tEntry) + (age > 1 ? "   (" + str.tostring(age) + " candles ago)" : ""), color.blue)
        f_row(5, "STOP LOSS", f_price(tSL) + "   = −" + str.tostring(riskPct) + "%  (" + f_money(riskMoney) + ")", SELL_COLOR)
        f_row(6, "TAKE PROFIT", f_price(tTP) + "   = +" + str.tostring(rr * riskPct, "#.#") + "%  (" + f_money(rr * riskMoney) + ")   RR 1 : " + str.tostring(rr, "#.#"), BUY_COLOR)
        f_row(7, "LOT SIZE", lot > 0 ? str.tostring(lot, "#.##") + " lot  =  risk " + f_money(riskMoney) + " (" + str.tostring(riskPct) + "%)" : "0.01 lot risks " + f_money(0.01 * risk * contractSize) + " – more than your " + str.tostring(riskPct) + "%", lot > 0 ? fg : color.orange)
        color gradeColor = tGrade == 0 ? BUY_COLOR : tGrade == 1 ? color.orange : SELL_COLOR
        f_row(8, "QUALITY", f_grade(tGrade) + "   " + str.tostring(tQuality) + "/100   ·   " + tWhy, gradeColor)
        // Win chance = how past signals of the same grade ended (needs 10+ to mean anything)
        int gN = array.get(gradeTrades, tGrade)
        int gW = array.get(gradeWins, tGrade)
        int allN = array.size(results)
        int allW = 0
        for r in results
            allW += r > 0 ? 1 : 0
        string chance = gN >= 10 ? str.tostring(100.0 * gW / gN, "#") + "%   (" + str.tostring(gW) + " of " + str.tostring(gN) + " past grade-" + f_grade(tGrade) + " signals hit TP)" : "Not enough grade-" + f_grade(tGrade) + " history yet (" + str.tostring(gN) + " trades)" + (allN > 0 ? "  ·  all signals: " + str.tostring(100.0 * allW / allN, "#") + "% of " + str.tostring(allN) : "")
        f_row(9, "WIN CHANCE", chance, gN >= 10 ? fg : color.gray)
    else
        [kA, tA, bA, sA] = f_areaAbove()
        [kB, tB, bB, sB] = f_areaBelow()
        string nextText = sessionFilterOn and not sessionOK ? "Outside " + sessionInput + " – no new trades until the session opens" : trendDir > 0 ? (kB == 0 ? "No buy area below – wait" : "Wait for a dip into " + f_areaText(kB, tB, bB, false) + ", then a bullish candle") : trendDir < 0 ? (kA == 0 ? "No sell area above – wait" : "Wait for a rally into " + f_areaText(kA, tA, bA, true) + ", then a bearish candle") : "Trend is flat – no trades until it turns"
        f_row(4, "NEXT", nextText, fg)
        if not na(skipBar) and bar_index - skipBar <= 10
            f_row(5, "NOTE", skipText, color.orange)
        string lastText = na(lastExitBar) ? "No closed trades yet" : (lastDir > 0 ? "BUY → " : "SELL → ") + lastHow + " " + f_r(lastR) + "   (" + str.tostring(bar_index - lastExitBar) + " candles ago)"
        f_row(6, "LAST TRADE", lastText, na(lastR) ? fg : lastR > 0 ? BUY_COLOR : SELL_COLOR)
    // Record = built-in backtest on the loaded history
    int n = array.size(results)
    if n > 0
        int wins = 0
        float total = 0.0
        int wins20 = 0
        float total20 = 0.0
        int first20 = math.max(0, n - 20)
        for [i, r] in results
            wins += r > 0 ? 1 : 0
            total += r
            if i >= first20
                wins20 += r > 0 ? 1 : 0
                total20 += r
        int n20 = n - first20
        string byGrade = ""
        for g = 0 to 2
            int gt = array.get(gradeTrades, g)
            if gt > 0
                byGrade += (byGrade == "" ? "" : "  ") + f_grade(g) + " " + str.tostring(100.0 * array.get(gradeWins, g) / gt, "#") + "% (" + str.tostring(gt) + ")"
        f_row(10, "RECORD", str.tostring(n) + " trades  ·  " + str.tostring(100.0 * wins / n, "#") + "% win  ·  avg " + f_r(total / n) + "  ·  total " + f_r(total), total >= 0 ? BUY_COLOR : SELL_COLOR)
        f_row(11, "LAST " + str.tostring(n20), str.tostring(100.0 * wins20 / n20, "#") + "% win  ·  total " + f_r(total20) + "   ·   by grade: " + byGrade, total20 >= 0 ? BUY_COLOR : SELL_COLOR)
    else
        f_row(10, "RECORD", "No closed trades in the loaded history yet", fg)
    // Why so few trades? Biggest blocker first
    if setupCount > 0
        array<int> counts = array.from(tradedCount, blockTrend, blockWeak, blockSession, blockTarget, blockBusy)
        array<string> names = array.from("traded", "trend", "area too weak", "session", "target too close", "trade open")
        array<int> ranked = array.sort_indices(counts, order.descending)
        string parts = ""
        for idx in ranked
            int c = array.get(counts, idx)
            if c > 0
                parts += (parts == "" ? "" : "  ·  ") + array.get(names, idx) + " " + str.tostring(c)
        f_row(12, "SETUPS", str.tostring(setupCount) + " since " + str.format_time(firstBarTime, "d MMM", syminfo.timezone) + ":  " + parts, color.gray)
