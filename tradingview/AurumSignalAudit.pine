//@version=6
indicator("Aurum Gold v5 - SNR + SND", shorttitle="Aurum v5", overlay=true, max_bars_back=2000, max_lines_count=100, max_boxes_count=50, max_labels_count=300)

// =====================================================================
// AURUM GOLD v5 — easy confluence indicator for XAUUSD (any timeframe)
//
// BUY  = higher-timeframe trend UP
//        + price dips into key areas: DEMAND zone (2 pts) and/or SUPPORT level (1 pt)
//        + the candle CLOSES back above the area (bullish candle or long lower wick)
// SELL = the mirror image (trend DOWN, SUPPLY / RESISTANCE, rejection down)
// Points needed: Aggressive 1, Balanced 2, Strict 3. Stars on the label = points (max 3).
//
// Signals are decided on CLOSED candles only, so a printed signal does not disappear.
// Shared rules with MT5: mt5/AurumCore.mqh. Demo research — not a guaranteed strategy.
// =====================================================================

// ---------- 1. Signals ----------
string modeInput = input.string("Balanced", "Signal mode", options=["Balanced", "Strict", "Aggressive"], display=display.none, group="1. Signals", tooltip="Points: Supply/Demand zone = 2, Support/Resistance = 1.\nAggressive: 1 point - any zone or S/R level (most signals).\nBalanced: 2 points - a supply/demand zone (recommended).\nStrict: 3 points - zone + S/R together (fewest, strongest).\nAll modes trade only with the trend.")
string swingInput = input.string("Normal", "Swing size", options=["Small", "Normal", "Large"], display=display.none, group="1. Signals", tooltip="How big a swing must be to make an S/R level.\nSmall = more levels (scalping). Large = only major levels (swing trading).")
string htfInput = input.timeframe("", "Trend timeframe (empty = auto)", display=display.none, group="1. Signals", tooltip="Auto: 1m→15m, 5m→1h, 15m-1h→4h, 2h-4h→1D, 1D→1W.")
int cooldown = input.int(5, "Candles between same-side signals", minval=0, maxval=50, display=display.none, group="1. Signals")

// ---------- 2. Show on chart ----------
bool showSR = input.bool(true, "Support / Resistance (SNR)", display=display.none, group="2. Show on chart")
bool showZones = input.bool(true, "Supply / Demand zones (SND)", display=display.none, group="2. Show on chart")
bool showTrade = input.bool(true, "Entry / SL / TP of last signal", display=display.none, group="2. Show on chart")
bool showEMA = input.bool(false, "EMA 50 / 200", display=display.none, group="2. Show on chart")
bool showPanel = input.bool(true, "Info panel", display=display.none, group="2. Show on chart")
string panelCorner = input.string("Top right", "Panel position", options=["Top right", "Bottom right", "Top left", "Bottom left"], display=display.none, group="2. Show on chart")

// ---------- 3. Advanced (defaults are fine) ----------
float impulseATR = input.float(1.5, "Zone impulse: candle body ≥ ATR ×", minval=0.5, maxval=5, step=0.1, display=display.none, group="3. Advanced")
float slBufferATR = input.float(0.2, "Stop-loss buffer beyond structure (ATR ×)", minval=0, maxval=2, step=0.05, display=display.none, group="3. Advanced")
float minRiskATR = input.float(0.5, "Minimum stop-loss distance (ATR ×)", minval=0.1, maxval=5, step=0.05, display=display.none, group="3. Advanced")
int maxItems = input.int(4, "Max zones / levels kept per side", minval=1, maxval=10, display=display.none, group="3. Advanced")
int atrLength = input.int(14, "ATR period", minval=2, maxval=200, display=display.none, group="3. Advanced")

// Fixed rule constants (same values as mt5/AurumCore.mqh)
float TOUCH_ATR = 0.2      // how close counts as "touching" an area
float MERGE_ATR = 0.3      // S/R levels closer than this are merged

int pivotLen = swingInput == "Small" ? 3 : swingInput == "Large" ? 10 : 5
int tfSec = timeframe.in_seconds()
string autoHTF = tfSec <= 60 ? "15" : tfSec <= 300 ? "60" : tfSec <= 3600 ? "240" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : "M"
string htf = htfInput == "" ? autoHTF : htfInput

// ---------- Market data ----------
float atrNow = ta.atr(atrLength)
float atrPrev = atrNow[1]          // previous candle's ATR: a big candle cannot inflate its own limits
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
// Completed higher-timeframe candle only ([1] + lookahead_on): no repainting.
[htfClose, htfEMA] = request.security(syminfo.tickerid, htf, [close[1], ta.ema(close, 200)[1]], lookahead=barmerge.lookahead_on)
int trendDir = not na(htfClose) and not na(htfEMA) ? (htfClose > htfEMA ? 1 : htfClose < htfEMA ? -1 : 0) : not na(ema200) ? (close > ema200 ? 1 : close < ema200 ? -1 : 0) : 0
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
bool ready = not na(atrPrev) and atrPrev > 0 and bar_index > pivotLen * 2 + atrLength

// ---------- Helpers ----------
f_bullRejection(float o, float h, float l, float c) =>
    float rng = h - l
    bool result = false
    if rng > 0
        result := c > o or (math.min(o, c) - l >= 0.5 * rng and c >= l + 0.5 * rng)
    result

f_bearRejection(float o, float h, float l, float c) =>
    float rng = h - l
    bool result = false
    if rng > 0
        result := c < o or (h - math.max(o, c) >= 0.5 * rng and c <= h - 0.5 * rng)
    result

// Add an S/R level, replacing any level within tol, keeping at most cap levels.
f_addLevel(array<float> prices, array<int> bars, float price, int barIdx, float tol, int cap) =>
    if array.size(prices) > 0
        for i = array.size(prices) - 1 to 0
            if math.abs(array.get(prices, i) - price) <= tol
                array.remove(prices, i)
                array.remove(bars, i)
    array.push(prices, price)
    array.push(bars, barIdx)
    while array.size(prices) > cap
        array.shift(prices)
        array.shift(bars)
    0

// Add a zone, replacing overlapping zones, keeping at most cap zones.
f_addZone(array<float> tops, array<float> bots, array<int> bars, float top, float bot, int barIdx, int cap) =>
    if array.size(tops) > 0
        for i = array.size(tops) - 1 to 0
            if array.get(bots, i) <= top and array.get(tops, i) >= bot
                array.remove(tops, i)
                array.remove(bots, i)
                array.remove(bars, i)
    array.push(tops, top)
    array.push(bots, bot)
    array.push(bars, barIdx)
    while array.size(tops) > cap
        array.shift(tops)
        array.shift(bots)
        array.shift(bars)
    0

f_price(float p) => na(p) ? "--" : str.tostring(p, format.mintick)
f_stars(int n) => n >= 3 ? "★★★" : n == 2 ? "★★" : "★"

// ---------- State (updated only on CLOSED candles) ----------
var array<float> resP = array.new<float>()
var array<int> resB = array.new<int>()
var array<float> supP = array.new<float>()
var array<int> supB = array.new<int>()
var array<float> dTop = array.new<float>()
var array<float> dBot = array.new<float>()
var array<int> dBar = array.new<int>()
var array<float> sTop = array.new<float>()
var array<float> sBot = array.new<float>()
var array<int> sBar = array.new<int>()
var int lastBuyBar = na
var int lastSellBar = na
var int sigDir = 0
var int sigBar = na
var int sigScore = 0
var float sigEntry = na
var float sigSL = na
var float sigTP1 = na
var float sigTP2 = na
var string areaText = "--"
var int sigState = 0          // 0 none, 1 active, 2 finished
var string sigResult = ""
var bool sigTP1Hit = false


// ---------- 0) Follow the active trade: SL / TP hit or expired ----------
if barstate.isconfirmed and sigState == 1 and bar_index > sigBar
    bool slHit = sigDir > 0 ? low <= sigSL : high >= sigSL
    bool tp2Hit = sigDir > 0 ? high >= sigTP2 : low <= sigTP2
    sigTP1Hit := sigTP1Hit or (sigDir > 0 ? high >= sigTP1 : low <= sigTP1)
    if slHit
        sigState := 2
        sigResult := sigTP1Hit ? "TP1 hit, then SL" : "SL hit"
    else if tp2Hit
        sigState := 2
        sigResult := "TP2 hit"
    else if bar_index - sigBar >= 100
        sigState := 2
        sigResult := sigTP1Hit ? "TP1 hit, expired" : "Expired"

// ---------- 1) Evaluate this closed candle against EXISTING areas ----------
bool buySignal = false
bool sellSignal = false
int buyScore = 0
int sellScore = 0
string buyWhy = ""
string sellWhy = ""
if barstate.isconfirmed and ready
    float tol = TOUCH_ATR * atrPrev
    // SND
    bool inDemand = false
    float demandLow = na
    for [i, top] in dTop
        float bot = array.get(dBot, i)
        if top > bot and low <= top + tol and close > top
            inDemand := true
            demandLow := na(demandLow) ? bot : math.min(demandLow, bot)
    bool inSupply = false
    float supplyHigh = na
    for [i, bot] in sBot
        float top = array.get(sTop, i)
        if top > bot and high >= bot - tol and close < bot
            inSupply := true
            supplyHigh := na(supplyHigh) ? top : math.max(supplyHigh, top)
    // SNR
    bool atSupport = false
    float supportLow = na
    for p in supP
        if low <= p + tol and close > p
            atSupport := true
            supportLow := na(supportLow) ? p : math.min(supportLow, p)
    bool atResistance = false
    float resistanceHigh = na
    for p in resP
        if high >= p - tol and close < p
            atResistance := true
            resistanceHigh := na(resistanceHigh) ? p : math.max(resistanceHigh, p)

    // Points: a supply/demand zone counts double
    buyScore := (inDemand ? 2 : 0) + (atSupport ? 1 : 0)
    sellScore := (inSupply ? 2 : 0) + (atResistance ? 1 : 0)
    buyWhy := str.trim((inDemand ? "Demand " : "") + (atSupport ? "Support" : ""))
    sellWhy := str.trim((inSupply ? "Supply " : "") + (atResistance ? "Resistance" : ""))
    areaText := buyScore > 0 and sellScore > 0 ? buyWhy + " / " + sellWhy : buyScore > 0 ? buyWhy + " (buy area)" : sellScore > 0 ? sellWhy + " (sell area)" : "No key area"

    int need = modeInput == "Strict" ? 3 : modeInput == "Aggressive" ? 1 : 2
    bool buyRaw = f_bullRejection(open, high, low, close) and buyScore >= need and trendDir > 0
    bool sellRaw = f_bearRejection(open, high, low, close) and sellScore >= need and trendDir < 0
    buySignal := buyRaw and not sellRaw and (na(lastBuyBar) or bar_index - lastBuyBar > cooldown)
    sellSignal := sellRaw and not buyRaw and (na(lastSellBar) or bar_index - lastSellBar > cooldown)

    if buySignal or sellSignal
        float entry = close
        float sl = na
        float nearest = na
        float nextArea = na
        if buySignal
            float structure = low
            structure := inDemand ? math.min(structure, demandLow) : structure
            structure := atSupport ? math.min(structure, supportLow) : structure
            sl := math.min(structure - slBufferATR * atrPrev, entry - minRiskATR * atrPrev)
            float risk = entry - sl
            // Targets = the next resistance / supply areas above
            array<float> targets = array.concat(array.copy(resP), array.copy(sBot))
            for p in targets
                if p >= entry + risk
                    nearest := na(nearest) ? p : math.min(nearest, p)
            sigTP1 := not na(nearest) ? nearest : entry + 1.5 * risk
            for p in targets
                if p >= sigTP1 + 0.5 * risk
                    nextArea := na(nextArea) ? p : math.min(nextArea, p)
            sigTP2 := not na(nextArea) ? nextArea : sigTP1 + risk
            lastBuyBar := bar_index
        else
            float structure = high
            structure := inSupply ? math.max(structure, supplyHigh) : structure
            structure := atResistance ? math.max(structure, resistanceHigh) : structure
            sl := math.max(structure + slBufferATR * atrPrev, entry + minRiskATR * atrPrev)
            float risk = sl - entry
            // Targets = the next support / demand areas below
            array<float> targets = array.concat(array.copy(supP), array.copy(dTop))
            for p in targets
                if p <= entry - risk
                    nearest := na(nearest) ? p : math.max(nearest, p)
            sigTP1 := not na(nearest) ? nearest : entry - 1.5 * risk
            for p in targets
                if p <= sigTP1 - 0.5 * risk
                    nextArea := na(nextArea) ? p : math.max(nextArea, p)
            sigTP2 := not na(nextArea) ? nextArea : sigTP1 - risk
            lastSellBar := bar_index
        sigDir := buySignal ? 1 : -1
        sigBar := bar_index
        sigState := 1
        sigResult := "Active"
        sigTP1Hit := false
        sigScore := buySignal ? buyScore : sellScore
        sigEntry := entry
        sigSL := sl
        string why = buySignal ? buyWhy : sellWhy
        string tag = (buySignal ? "BUY " : "SELL ") + f_stars(sigScore) + "\n" + why
        if buySignal
            label.new(bar_index, low, tag, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
        else
            label.new(bar_index, high, tag, yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
        alert((buySignal ? "Aurum BUY " : "Aurum SELL ") + f_stars(sigScore) + " | " + syminfo.ticker + " " + timeframe.period + " | " + why + " | Entry " + f_price(sigEntry) + " | SL " + f_price(sigSL) + " | TP1 " + f_price(sigTP1) + " | TP2 " + f_price(sigTP2), alert.freq_once_per_bar_close)

// ---------- 2) Update areas with this closed candle ----------
if barstate.isconfirmed and ready
    float mergeTol = MERGE_ATR * atrPrev
    // Zones die when a candle CLOSES through them
    if array.size(dTop) > 0
        for i = array.size(dTop) - 1 to 0
            if close < array.get(dBot, i)
                array.remove(dTop, i)
                array.remove(dBot, i)
                array.remove(dBar, i)
    if array.size(sTop) > 0
        for i = array.size(sTop) - 1 to 0
            if close > array.get(sTop, i)
                array.remove(sTop, i)
                array.remove(sBot, i)
                array.remove(sBar, i)
    // SNR role flip: broken resistance becomes support and vice versa
    array<float> toSup = array.new<float>()
    array<int> toSupBar = array.new<int>()
    array<float> toRes = array.new<float>()
    array<int> toResBar = array.new<int>()
    if array.size(resP) > 0
        for i = array.size(resP) - 1 to 0
            if close > array.get(resP, i)
                array.push(toSup, array.get(resP, i))
                array.push(toSupBar, array.get(resB, i))
                array.remove(resP, i)
                array.remove(resB, i)
    if array.size(supP) > 0
        for i = array.size(supP) - 1 to 0
            if close < array.get(supP, i)
                array.push(toRes, array.get(supP, i))
                array.push(toResBar, array.get(supB, i))
                array.remove(supP, i)
                array.remove(supB, i)
    for [i, p] in toSup
        f_addLevel(supP, supB, p, array.get(toSupBar, i), mergeTol, maxItems)
    for [i, p] in toRes
        f_addLevel(resP, resB, p, array.get(toResBar, i), mergeTol, maxItems)
    // New SND zone from this candle (previous candle = base)
    if close - open >= impulseATR * atrPrev and close > high[1]
        float bot = math.min(low[1], low)
        float top = math.max(open[1], close[1])
        top := top - bot < 0.2 * atrPrev ? bot + 0.2 * atrPrev : top
        if top - bot <= 2.0 * atrPrev and top < close
            f_addZone(dTop, dBot, dBar, top, bot, bar_index - 1, maxItems)
    if open - close >= impulseATR * atrPrev and close < low[1]
        float top = math.max(high[1], high)
        float bot = math.min(open[1], close[1])
        bot := top - bot < 0.2 * atrPrev ? top - 0.2 * atrPrev : bot
        if top - bot <= 2.0 * atrPrev and bot > close
            f_addZone(sTop, sBot, sBar, top, bot, bar_index - 1, maxItems)
    // New SNR levels from confirmed swing points
    if not na(ph)
        if close < ph
            f_addLevel(resP, resB, ph, bar_index - pivotLen, mergeTol, maxItems)
        else
            f_addLevel(supP, supB, ph, bar_index - pivotLen, mergeTol, maxItems)
    if not na(pl)
        if close > pl
            f_addLevel(supP, supB, pl, bar_index - pivotLen, mergeTol, maxItems)
        else
            f_addLevel(resP, resB, pl, bar_index - pivotLen, mergeTol, maxItems)

// ---------- Plots, data window and alerts ----------
plot(showEMA ? ema50 : na, "EMA 50", color=color.orange, linewidth=1, display=display.pane)
plot(showEMA ? ema200 : na, "EMA 200", color=color.gray, linewidth=2, display=display.pane)
plot(buySignal ? 1 : sellSignal ? -1 : 0, "Signal: BUY=1 SELL=-1", display=display.data_window)
plot(buySignal ? buyScore : sellSignal ? sellScore : 0, "Signal stars", display=display.data_window)
plot(trendDir, "Trend: UP=1 DOWN=-1", display=display.data_window)
alertcondition(buySignal, title="Aurum BUY", message="Aurum BUY | {{ticker}} {{interval}} | close {{close}} | check Entry/SL/TP on chart")
alertcondition(sellSignal, title="Aurum SELL", message="Aurum SELL | {{ticker}} {{interval}} | close {{close}} | check Entry/SL/TP on chart")
alertcondition(buySignal or sellSignal, title="Aurum BUY or SELL", message="Aurum signal | {{ticker}} {{interval}} | close {{close}} | check direction and Entry/SL/TP on chart")

// ---------- Drawings (rebuilt on the last bar only) ----------
var array<line> drawLines = array.new<line>()
var array<box> drawBoxes = array.new<box>()
var array<label> drawLabels = array.new<label>()
color DEMAND_COLOR = color.teal
color SUPPLY_COLOR = color.red
// Only areas near current price are drawn, so old far-away levels do not squash the chart.
float nearRange = 8 * nz(atrNow, 0)
f_near(float p) => math.abs(p - close) <= nearRange
if barstate.islast
    for item in drawLines
        line.delete(item)
    for item in drawBoxes
        box.delete(item)
    for item in drawLabels
        label.delete(item)
    array.clear(drawLines)
    array.clear(drawBoxes)
    array.clear(drawLabels)
    int rightX = bar_index + 12
    if showZones
        for [i, top] in dTop
            float bot = array.get(dBot, i)
            // A demand zone must be at or below price; anything else is stale
            if (f_near(top) or f_near(bot)) and bot <= close
                array.push(drawBoxes, box.new(array.get(dBar, i), top, rightX, bot, border_color=color.new(DEMAND_COLOR, 40), bgcolor=color.new(DEMAND_COLOR, 82), text="Demand", text_size=size.tiny, text_color=color.new(DEMAND_COLOR, 0), text_halign=text.align_right))
        for [i, top] in sTop
            float bot = array.get(sBot, i)
            // A supply zone must be at or above price; anything else is stale
            if (f_near(top) or f_near(bot)) and top >= close
                array.push(drawBoxes, box.new(array.get(sBar, i), top, rightX, bot, border_color=color.new(SUPPLY_COLOR, 40), bgcolor=color.new(SUPPLY_COLOR, 82), text="Supply", text_size=size.tiny, text_color=color.new(SUPPLY_COLOR, 0), text_halign=text.align_right))
    if showSR
        for [i, p] in supP
            if f_near(p)
                array.push(drawLines, line.new(array.get(supB, i), p, rightX, p, color=color.new(DEMAND_COLOR, 20), width=1, style=line.style_dashed))
                array.push(drawLabels, label.new(rightX, p, "S " + f_price(p), style=label.style_label_left, color=color.new(DEMAND_COLOR, 30), textcolor=color.white, size=size.tiny))
        for [i, p] in resP
            if f_near(p)
                array.push(drawLines, line.new(array.get(resB, i), p, rightX, p, color=color.new(SUPPLY_COLOR, 20), width=1, style=line.style_dashed))
                array.push(drawLabels, label.new(rightX, p, "R " + f_price(p), style=label.style_label_left, color=color.new(SUPPLY_COLOR, 30), textcolor=color.white, size=size.tiny))
    // Trade lines only while the trade is still active (not SL / TP2 / expired)
    if showTrade and sigState == 1 and not na(sigBar)
        array<float> values = array.from(sigEntry, sigSL, sigTP1, sigTP2)
        array<string> names = array.from(sigDir > 0 ? "BUY entry" : "SELL entry", "Stop loss", "TP1", "TP2")
        for i = 0 to 3
            float p = array.get(values, i)
            color c = i == 0 ? color.blue : i == 1 ? color.red : color.green
            array.push(drawLines, line.new(sigBar, p, bar_index + 4, p, color=c, width=2))
            array.push(drawLabels, label.new(bar_index + 4, p, array.get(names, i) + "  " + f_price(p), style=label.style_label_left, color=c, textcolor=color.white, size=size.tiny))

// ---------- Info panel ----------
string panelPosition = switch panelCorner
    "Top left" => position.top_left
    "Bottom left" => position.bottom_left
    "Bottom right" => position.bottom_right
    => position.top_right
var table panel = table.new(panelPosition, 2, 9, bgcolor=color.new(chart.bg_color, 5), frame_color=color.gray, frame_width=1, border_color=color.new(color.gray, 70), border_width=1)
f_row(int row, string name, string value, color valueColor) =>
    table.cell(panel, 0, row, name, text_color=chart.fg_color, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, row, value, text_color=valueColor, text_size=size.small, text_halign=text.align_left)
if barstate.islast and showPanel
    string trendText = trendDir > 0 ? "UP ▲  (look for BUY)" : trendDir < 0 ? "DOWN ▼  (look for SELL)" : "FLAT  (wait)"
    color trendColor = trendDir > 0 ? color.teal : trendDir < 0 ? color.red : color.gray
    string lastText = sigDir == 0 ? "None yet" : (sigDir > 0 ? "BUY " : "SELL ") + f_stars(sigScore) + "  " + str.tostring(bar_index - sigBar) + " bars ago - " + (sigState == 1 ? "ACTIVE" : sigResult)
    bool active = sigState == 1
    color lastColor = sigDir > 0 ? color.teal : sigDir < 0 ? color.red : chart.fg_color
    string nextText = trendDir > 0 ? "Wait: dip into Demand / Support + bullish close" : trendDir < 0 ? "Wait: rally into Supply / Resistance + bearish close" : "Trend flat: no signals until it turns"
    table.cell(panel, 0, 0, "AURUM GOLD v5", text_color=color.orange, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, 0, timeframe.period + " chart | trend TF " + htf, text_color=chart.fg_color, text_size=size.small, text_halign=text.align_left)
    f_row(1, "Trend", trendText, trendColor)
    f_row(2, "Mode", modeInput, chart.fg_color)
    f_row(3, "Price at", areaText, chart.fg_color)
    f_row(4, "Last signal", lastText, lastColor)
    f_row(5, "Entry", active ? f_price(sigEntry) : "--  (no active trade)", color.blue)
    f_row(6, "Stop loss", active ? f_price(sigSL) : "--", color.red)
    f_row(7, "TP1 / TP2", active ? f_price(sigTP1) + "  /  " + f_price(sigTP2) + (sigTP1Hit ? "  (TP1 hit)" : "") : "--", color.green)
    f_row(8, "Next", nextText, chart.fg_color)
