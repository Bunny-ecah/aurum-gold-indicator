//@version=6
indicator("Aurum Gold - Entry Planner v3", shorttitle="Aurum Plan", overlay=true, max_bars_back=5000, max_lines_count=20, max_labels_count=20)

// Demo research presets, not optimized or validated trading recommendations.
// Confirmed HTF snapshots are taken at ENTRY BAR OPEN, via [1] + lookahead_on.
string profile = input.string("Auto chart", "Timeframe profile", options=["Auto chart", "1 minute", "5 minutes", "15 minutes", "30 minutes", "1 hour"], group="Profile")
string setupInput = input.string("Auto profile", "Setup type", options=["Auto profile", "EMA pullback reclaim", "Range breakout", "Breakout retest", "Momentum breakout"], group="Profile")
bool useDefaults = input.bool(true, "Use timeframe preset parameters", group="Profile", tooltip="Turn off to use the Manual parameters below. Retest window/tolerance and filter toggles always remain editable.")
bool requireContext = input.bool(true, "Require second higher-timeframe trend", group="Filters")
bool requireDMI = input.bool(true, "Require ADX strength and DI direction", group="Filters")
bool directionalCandle = input.bool(true, "Require bullish BUY / bearish SELL candle", group="Filters")
float minATR = input.float(0.0, "Minimum ATR in price units (0 = off)", minval=0, group="Filters")
float maxATR = input.float(0.0, "Maximum ATR in price units (0 = off)", minval=0, group="Filters")
bool limitExtension = input.bool(true, "Block price stretched from fast EMA", group="Filters")
int retestBars = input.int(3, "Retest within N candles after breakout", minval=1, maxval=10, group="Retest")
float retestTolerance = input.float(0.20, "Retest zone tolerance / breakout's prior ATR", minval=0, maxval=2, step=0.05, group="Retest")
int manualFast = input.int(20, "Fast EMA", minval=2, maxval=1000, group="Manual parameters")
int manualSlow = input.int(50, "Slow EMA", minval=3, maxval=2000, group="Manual parameters")
float manualBuyMin = input.float(55, "BUY RSI minimum", minval=0, maxval=100, group="Manual parameters")
float manualBuyMax = input.float(70, "BUY RSI maximum", minval=0, maxval=100, group="Manual parameters")
float manualSellMin = input.float(30, "SELL RSI minimum", minval=0, maxval=100, group="Manual parameters")
float manualSellMax = input.float(45, "SELL RSI maximum", minval=0, maxval=100, group="Manual parameters")
int manualBreakout = input.int(5, "Breakout range candles", minval=1, maxval=500, group="Manual parameters")
float manualBuffer = input.float(0.05, "Breakout distance / previous ATR", minval=0, maxval=3, step=0.05, group="Manual parameters")
float manualADX = input.float(20, "ADX minimum", minval=0, maxval=100, group="Manual parameters")
float manualRange = input.float(2.0, "Maximum candle range / previous ATR", minval=0.1, maxval=10, group="Manual parameters")
float manualExtension = input.float(1.5, "Maximum close-to-fast-EMA distance / prior ATR", minval=0.1, maxval=10, group="Manual parameters")
int manualQuiet = input.int(3, "Required prior candidate-free candles", minval=0, maxval=100, group="Manual parameters")
int trendLength = input.int(200, "Higher-timeframe EMA period", minval=2, maxval=2000, group="Shared indicator periods")
int rsiLength = input.int(14, "RSI period", minval=2, maxval=1000, group="Shared indicator periods")
int atrLength = input.int(14, "ATR period", minval=2, maxval=1000, group="Shared indicator periods")
int diLength = input.int(14, "DI period", minval=2, maxval=100, group="Shared indicator periods")
int adxSmoothing = input.int(14, "ADX smoothing", minval=2, maxval=100, group="Shared indicator periods")
bool showEMAs = input.bool(true, "Show closed-candle EMAs", group="Display")
bool showSignals = input.bool(true, "Show BUY / SELL labels", group="Display")
bool showPanel = input.bool(true, "Show closed-candle checklist", group="Display")
bool showRetestZone = input.bool(true, "Show current retest anchor", group="Display")
bool enableAlerts = input.bool(true, "Enable alert conditions", group="Alerts")
bool showPlan = input.bool(true, "Draw latest entry / stop / targets", group="Entry planner")
int entryExpiry = input.int(3, "Entry expires after N candles", minval=1, maxval=20, group="Entry planner")
float entryBufferATR = input.float(0.05, "Entry beyond signal high/low / prior ATR", minval=0, maxval=2, step=0.05, group="Entry planner")
int stopLookback = input.int(5, "Structure stop lookback (includes signal)", minval=1, maxval=50, group="Entry planner")
float stopBufferATR = input.float(0.15, "Stop beyond structure / prior ATR", minval=0, maxval=2, step=0.05, group="Entry planner")
float minimumRiskATR = input.float(0.75, "Minimum entry-to-stop / prior ATR", minval=0.1, maxval=5, step=0.05, group="Entry planner")
float maximumRiskATR = input.float(3.0, "Maximum entry-to-stop / prior ATR", minval=0.2, maxval=10, step=0.1, group="Entry planner")
float target1R = input.float(1.0, "Target 1 / initial risk", minval=0.25, maxval=10, step=0.25, group="Entry planner")
float target2R = input.float(2.0, "Target 2 / initial risk", minval=0.5, maxval=20, step=0.25, group="Entry planner")
float maximumGapATR = input.float(0.20, "Reject opening gap beyond entry / plan ATR", minval=0, maxval=2, step=0.05, group="Entry planner")
int observationBars = input.int(30, "Stop tracking after N candles from trigger", minval=1, maxval=200, group="Entry planner")
int projectionBars = input.int(8, "Line projection candles", minval=1, maxval=100, group="Entry planner")
bool useSRRoom = input.bool(false, "Block target 1 behind latest confirmed S/R", group="Entry planner")
int pivotBars = input.int(3, "S/R pivot left/right candles", minval=1, maxval=20, group="Entry planner")
string panelMode = input.string("Compact", "Panel detail", options=["Compact", "Detailed"], group="Display")
string panelCorner = input.string("Bottom right", "Panel position", options=["Top right", "Bottom right", "Top left", "Bottom left"], group="Display")
string panelTextSize = input.string("Small", "Panel text size", options=["Tiny", "Small", "Normal"], group="Display")

int selectedMinutes = switch profile
    "1 minute" => 1
    "5 minutes" => 5
    "15 minutes" => 15
    "30 minutes" => 30
    "1 hour" => 60
    => timeframe.multiplier
bool supported = timeframe.isminutes and (selectedMinutes == 1 or selectedMinutes == 5 or selectedMinutes == 15 or selectedMinutes == 30 or selectedMinutes == 60)
string trendTF = switch selectedMinutes
    1 => "5"
    5 => "15"
    15 => "60"
    30 => "120"
    => "240"
string contextTF = switch selectedMinutes
    1 => "15"
    5 => "60"
    15 => "240"
    30 => "240"
    => "1D"
string defaultSetup = switch selectedMinutes
    1 => "EMA pullback reclaim"
    15 => "Breakout retest"
    30 => "Momentum breakout"
    => "Range breakout"
string setup = setupInput == "Auto profile" ? defaultSetup : setupInput
int fastLength = useDefaults ? (selectedMinutes == 1 ? 9 : 20) : manualFast
int slowLength = useDefaults ? (selectedMinutes == 1 ? 21 : 50) : manualSlow
float buyMin = useDefaults ? (selectedMinutes == 1 ? 58.0 : 55.0) : manualBuyMin
float buyMax = useDefaults ? (selectedMinutes == 1 ? 68.0 : 70.0) : manualBuyMax
float sellMin = useDefaults ? (selectedMinutes == 1 ? 32.0 : 30.0) : manualSellMin
float sellMax = useDefaults ? (selectedMinutes == 1 ? 42.0 : 45.0) : manualSellMax
int breakoutLength = useDefaults ? (selectedMinutes == 30 ? 8 : 5) : manualBreakout
float breakoutBuffer = useDefaults ? (selectedMinutes == 30 ? 0.10 : 0.05) : manualBuffer
float minADX = useDefaults ? (selectedMinutes == 1 or selectedMinutes == 30 ? 22.0 : 20.0) : manualADX
float maxRangeATR = useDefaults ? (selectedMinutes == 1 ? 1.5 : 2.0) : manualRange
float maxExtension = useDefaults ? (selectedMinutes == 1 ? 1.25 : selectedMinutes == 30 ? 2.0 : 1.5) : manualExtension
int quietBars = useDefaults ? (selectedMinutes == 1 ? 5 : 3) : manualQuiet
if barstate.isfirst
    if not supported
        runtime.error("Use a standard 1m, 5m, 15m, 30m or 1h chart.")
    if timeframe.multiplier != selectedMinutes
        runtime.error("Selected profile does not match the chart. Use Auto chart or match both timeframes.")
    if not chart.is_standard
        runtime.error("Use standard time-based candles. Synthetic candles are not supported.")
    if fastLength >= slowLength
        runtime.error("Fast EMA must be shorter than Slow EMA.")
    if buyMin > buyMax or sellMin > sellMax or sellMax >= buyMin
        runtime.error("Invalid RSI ranges. SELL maximum must be below BUY minimum.")
    if maxATR > 0 and maxATR < minATR
        runtime.error("Maximum ATR must be zero (off) or at least Minimum ATR.")
    if maximumRiskATR < minimumRiskATR or target2R <= target1R
        runtime.error("Maximum risk must be >= minimum risk, and target 2 must exceed target 1.")

float fastEMA = ta.ema(close, fastLength)
float slowEMA = ta.ema(close, slowLength)
float rsiValue = ta.rsi(close, rsiLength)
float atrValue = ta.atr(atrLength)
float priorATR = atrValue[1]
float rangeHigh = ta.highest(high[1], breakoutLength)
float rangeLow = ta.lowest(low[1], breakoutLength)
[plusDI, minusDI, adxValue] = ta.dmi(diLength, adxSmoothing)
[macdLine, macdSignal, macdHistogram] = ta.macd(close, 12, 26, 9)
// Offsets apply to ALL tuple elements. No forming higher-timeframe close is used.
[trendClose, trendEMA, trendIndex] = request.security(syminfo.tickerid, trendTF, [close[1], ta.ema(close, trendLength)[1], bar_index[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[contextClose, contextEMA, contextIndex] = request.security(syminfo.tickerid, contextTF, [close[1], ta.ema(close, trendLength)[1], bar_index[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

bool contextReady = not na(contextClose) and not na(contextEMA) and not na(contextIndex) and contextIndex >= trendLength + 10
bool entryReady = bar_index >= math.max(slowLength, math.max(rsiLength, math.max(atrLength, diLength + adxSmoothing))) + breakoutLength + retestBars + 10
bool baseReady = entryReady and not na(fastEMA) and not na(slowEMA) and not na(rsiValue) and not na(priorATR) and priorATR > 0 and not na(atrValue) and atrValue > 0 and not na(rangeHigh) and not na(rangeLow) and not na(trendClose) and not na(trendEMA) and not na(trendIndex) and trendIndex >= trendLength + 10 and (not requireContext or contextReady)
bool dmiReady = not requireDMI or (not na(adxValue) and not na(plusDI) and not na(minusDI))
bool momentumReady = setup != "Momentum breakout" or (not na(macdHistogram) and not na(macdHistogram[1]))
bool dataReady = baseReady and dmiReady and momentumReady
bool trendBuy = dataReady and trendClose > trendEMA and (not requireContext or contextClose > contextEMA)
bool trendSell = dataReady and trendClose < trendEMA and (not requireContext or contextClose < contextEMA)
bool emaBuy = dataReady and fastEMA > slowEMA and close > fastEMA
bool emaSell = dataReady and fastEMA < slowEMA and close < fastEMA
bool rsiBuy = dataReady and rsiValue >= buyMin and rsiValue <= buyMax
bool rsiSell = dataReady and rsiValue >= sellMin and rsiValue <= sellMax
bool strengthBuy = dataReady and (not requireDMI or (adxValue >= minADX and plusDI > minusDI))
bool strengthSell = dataReady and (not requireDMI or (adxValue >= minADX and minusDI > plusDI))

// Breakouts use ONLY the preceding N candles and the previous candle ATR.
bool breakoutBuy = baseReady and close > rangeHigh + breakoutBuffer * priorATR
bool breakoutSell = baseReady and close < rangeLow - breakoutBuffer * priorATR
// 1m default: preceding candle closes on/below fast EMA, current close reclaims
// that EMA AND the previous candle high. SELL mirrors this exactly.
bool reclaimBuy = baseReady and not na(fastEMA[1]) and low[1] <= fastEMA[1] and close[1] <= fastEMA[1] and close > fastEMA and close > high[1]
bool reclaimSell = baseReady and not na(fastEMA[1]) and high[1] >= fastEMA[1] and close[1] >= fastEMA[1] and close < fastEMA and close < low[1]

// 15m default: most recent breakout within a bounded window, then a LATER
// candle tests the original, FIXED range level. Never use same-candle retests.
bool retestBuy = false
bool retestSell = false
float buyAnchor = na
float sellAnchor = na
if setup == "Breakout retest"
    bool foundBuy = false
    bool foundSell = false
    for j = 1 to retestBars
        if not foundBuy and breakoutBuy[j]
            foundBuy := true
            float level = rangeHigh[j]
            float tolerance = retestTolerance * priorATR[j]
            bool held = true
            if j > 1
                for m = 1 to j - 1
                    if close[m] < level
                        held := false
            buyAnchor := level
            retestBuy := held and low >= level - tolerance and low <= level + tolerance and close > level
        if not foundSell and breakoutSell[j]
            foundSell := true
            float level = rangeLow[j]
            float tolerance = retestTolerance * priorATR[j]
            bool held = true
            if j > 1
                for m = 1 to j - 1
                    if close[m] > level
                        held := false
            sellAnchor := level
            retestSell := held and high >= level - tolerance and high <= level + tolerance and close < level

// 30m default: range breakout + expanding MACD histogram + fast EMA slope.
bool momentumBuy = breakoutBuy and macdHistogram > 0 and macdHistogram > macdHistogram[1] and fastEMA > fastEMA[1]
bool momentumSell = breakoutSell and macdHistogram < 0 and macdHistogram < macdHistogram[1] and fastEMA < fastEMA[1]
bool triggerBuy = switch setup
    "EMA pullback reclaim" => reclaimBuy
    "Breakout retest" => retestBuy
    "Momentum breakout" => momentumBuy
    => breakoutBuy
bool triggerSell = switch setup
    "EMA pullback reclaim" => reclaimSell
    "Breakout retest" => retestSell
    "Momentum breakout" => momentumSell
    => breakoutSell

bool atrOK = dataReady and atrValue >= minATR and (maxATR == 0 or atrValue <= maxATR)
bool rangeOK = dataReady and high - low <= maxRangeATR * priorATR
bool extensionOK = dataReady and (not limitExtension or math.abs(close - fastEMA) <= maxExtension * priorATR)
bool candleBuy = not directionalCandle or close > open
bool candleSell = not directionalCandle or close < open
int buyCount = (trendBuy ? 1 : 0) + (emaBuy ? 1 : 0) + (rsiBuy ? 1 : 0) + (triggerBuy ? 1 : 0) + (strengthBuy ? 1 : 0)
int sellCount = (trendSell ? 1 : 0) + (emaSell ? 1 : 0) + (rsiSell ? 1 : 0) + (triggerSell ? 1 : 0) + (strengthSell ? 1 : 0)
int requiredCount = requireDMI ? 5 : 4
// Disabled DMI is omitted from the visible count, rather than credited as evidence.
int visibleBuyCount = buyCount - (not requireDMI and strengthBuy ? 1 : 0)
int visibleSellCount = sellCount - (not requireDMI and strengthSell ? 1 : 0)
bool rawBuy = dataReady and trendBuy and emaBuy and rsiBuy and triggerBuy and strengthBuy and atrOK and rangeOK and extensionOK and candleBuy
bool rawSell = dataReady and trendSell and emaSell and rsiSell and triggerSell and strengthSell and atrOK and rangeOK and extensionOK and candleSell
bool rawCandidate = rawBuy or rawSell
bool recentCandidate = false
bool historyReady = dataReady
if quietBars > 0
    for j = 1 to quietBars
        recentCandidate := recentCandidate or rawCandidate[j]
        historyReady := historyReady and dataReady[j]
bool quietOK = historyReady and not recentCandidate
bool buySignal = barstate.isconfirmed and rawBuy and quietOK
bool sellSignal = barstate.isconfirmed and rawSell and quietOK

// ENTRY PLANNER: chart observations only. No broker order/fill is inferred.
f_up(float price) => math.ceil(price / syminfo.mintick) * syminfo.mintick
f_down(float price) => math.floor(price / syminfo.mintick) * syminfo.mintick
f_price(float price) => na(price) ? "--" : str.tostring(price, format.mintick)
f_pending_event(int direction, float o, float h, float l, float e, float s, float gap) =>
    bool pStop = direction == 1 ? l <= s : h >= s
    bool pTrigger = direction == 1 ? h >= e : l <= e
    bool pGap = direction == 1 ? o > e + gap : o < e - gap
    pStop and pTrigger ? "AMBIGUOUS: entry + stop" : pStop ? "INVALID: stop before entry" : pTrigger and pGap ? "MISSED: opening gap" : pTrigger ? "TRIGGER OBSERVED" : "PENDING"
f_observed_event(int direction, float h, float l, float s, float t2) =>
    bool aStop = direction == 1 ? l <= s : h >= s
    bool aTarget = direction == 1 ? h >= t2 : l <= t2
    aStop and aTarget ? "AMBIGUOUS: stop + TP2" : aStop ? "STOP LEVEL OBSERVED" : aTarget ? "TP2 LEVEL OBSERVED" : "TRIGGER OBSERVED"

float structureLow = ta.lowest(low, stopLookback)
float structureHigh = ta.highest(high, stopLookback)
float pivotHigh = ta.pivothigh(high, pivotBars, pivotBars)
float pivotLow = ta.pivotlow(low, pivotBars, pivotBars)
var float resistance = na
var float support = na
if barstate.isconfirmed
    if not na(pivotHigh)
        resistance := pivotHigh
    if not na(pivotLow)
        support := pivotLow
    if not na(resistance) and close > resistance
        resistance := na
    if not na(support) and close < support
        support := na

float nextBuyEntry = f_up(high + math.max(entryBufferATR * priorATR, syminfo.mintick))
float nextSellEntry = f_down(low - math.max(entryBufferATR * priorATR, syminfo.mintick))
float nextBuyStop = f_down(math.min(structureLow - stopBufferATR * priorATR, nextBuyEntry - minimumRiskATR * priorATR))
float nextSellStop = f_up(math.max(structureHigh + stopBufferATR * priorATR, nextSellEntry + minimumRiskATR * priorATR))
float buyRisk = nextBuyEntry - nextBuyStop
float sellRisk = nextSellStop - nextSellEntry
float nextBuyT1 = f_up(nextBuyEntry + target1R * buyRisk)
float nextBuyT2 = f_up(nextBuyEntry + target2R * buyRisk)
float nextSellT1 = f_down(nextSellEntry - target1R * sellRisk)
float nextSellT2 = f_down(nextSellEntry - target2R * sellRisk)
bool buyRiskOK = dataReady and not na(nextBuyStop) and nextBuyStop > 0 and buyRisk >= syminfo.mintick and buyRisk <= maximumRiskATR * priorATR and nextBuyT2 > nextBuyT1 and nextBuyT1 > nextBuyEntry
bool sellRiskOK = dataReady and not na(nextSellStop) and nextSellEntry > 0 and nextSellT2 > 0 and sellRisk >= syminfo.mintick and sellRisk <= maximumRiskATR * priorATR and nextSellT2 < nextSellT1 and nextSellT1 < nextSellEntry
bool buyRoomOK = not useSRRoom or na(resistance) or resistance <= nextBuyEntry or resistance >= nextBuyT1
bool sellRoomOK = not useSRRoom or na(support) or support >= nextSellEntry or support <= nextSellT1

// State: 0 no plan, 1 pending, 2 trigger observed, 3 finished/invalid/expired.
var int planState = 0
var int planDirection = 0
var int planBar = na
var int triggerBar = na
var int signalTime = na
var float planEntry = na
var float planStop = na
var float planT1 = na
var float planT2 = na
var float planATR = na
var bool t1Observed = false
var string planStatus = "WAIT FOR SETUP"
var array<line> levelLines = array.new<line>()
var array<label> levelLabels = array.new<label>()
bool busyAtStart = planState == 1 or planState == 2
bool newBuyPlan = false
bool newSellPlan = false
bool triggerObserved = false

if barstate.isconfirmed
    if planState == 1 and bar_index > planBar
        if bar_index - planBar > entryExpiry
            planState := 3
            planStatus := "EXPIRED: entry not triggered"
        else
            string event = f_pending_event(planDirection, open, high, low, planEntry, planStop, maximumGapATR * planATR)
            if event == "TRIGGER OBSERVED"
                planState := 2
                triggerBar := bar_index
                triggerObserved := true
                planStatus := event
                t1Observed := planDirection == 1 ? high >= planT1 : low <= planT1
                bool immediateTarget2 = planDirection == 1 ? high >= planT2 : low <= planT2
                if immediateTarget2
                    planState := 3
                    planStatus := "TP2 LEVEL OBSERVED"
            else if event != "PENDING"
                planState := 3
                planStatus := event
            else if bar_index - planBar >= entryExpiry
                planState := 3
                planStatus := "EXPIRED: entry not triggered"
    else if planState == 2
        string event = f_observed_event(planDirection, high, low, planStop, planT2)
        if event != "TRIGGER OBSERVED"
            planState := 3
            planStatus := event
        else if bar_index - triggerBar >= observationBars
            planState := 3
            planStatus := "TRACKING ENDED: time limit"
        else
            bool hitT1 = planDirection == 1 ? high >= planT1 : low <= planT1
            t1Observed := t1Observed or hitT1
            planStatus := t1Observed ? "TP1 OBSERVED: tracking TP2" : "TRIGGER OBSERVED"

    // Never replace a plan that was pending/observed at the START of this candle.
    newBuyPlan := buySignal and buyRiskOK and buyRoomOK and not busyAtStart
    newSellPlan := sellSignal and sellRiskOK and sellRoomOK and not busyAtStart
    if newBuyPlan or newSellPlan
        planDirection := newBuyPlan ? 1 : -1
        planState := 1
        planStatus := "PENDING: break signal high/low"
        planBar := bar_index
        signalTime := time_close
        triggerBar := na
        planATR := priorATR
        planEntry := newBuyPlan ? nextBuyEntry : nextSellEntry
        planStop := newBuyPlan ? nextBuyStop : nextSellStop
        planT1 := newBuyPlan ? nextBuyT1 : nextSellT1
        planT2 := newBuyPlan ? nextBuyT2 : nextSellT2
        t1Observed := false
        for item in levelLines
            line.delete(item)
        for item in levelLabels
            label.delete(item)
        array.clear(levelLines)
        array.clear(levelLabels)
        if showPlan
            array<float> values = array.from(planEntry, planStop, planT1, planT2)
            array<string> names = array.from(planDirection == 1 ? "BUY STOP ref" : "SELL STOP ref", "STOP ref", "TP1 ref", "TP2 ref")
            for i = 0 to 3
                float price = array.get(values, i)
                color levelColor = i == 0 ? color.blue : i == 1 ? color.red : color.teal
                line item = line.new(bar_index, price, bar_index + projectionBars, price, color=levelColor, width=i == 0 ? 2 : 1)
                label tag = label.new(bar_index + projectionBars, price, array.get(names, i) + " " + f_price(price), style=label.style_label_left, color=color.new(levelColor, 15), textcolor=color.white, size=size.tiny)
                array.push(levelLines, item)
                array.push(levelLabels, tag)
    // Stop extending a terminal plan. Levels and status remain as historical references.
    if showPlan and array.size(levelLines) > 0 and (busyAtStart or newBuyPlan or newSellPlan)
        for i = 0 to array.size(levelLines) - 1
            line item = array.get(levelLines, i)
            label tag = array.get(levelLabels, i)
            int rightEdge = planState == 1 or planState == 2 ? bar_index + projectionBars : bar_index
            line.set_x2(item, rightEdge)
            label.set_x(tag, rightEdge)
            if planState == 3
                line.set_style(item, line.style_dashed)
                label.set_color(tag, color.new(color.gray, 25))

// Hidden plots allow static alert messages to include the newly created plan prices.
plot(newBuyPlan or newSellPlan ? planEntry : na, "Plan Entry", display=display.none)
plot(newBuyPlan or newSellPlan ? planStop : na, "Plan Stop", display=display.none)
plot(newBuyPlan or newSellPlan ? planT1 : na, "Plan TP1", display=display.none)
plot(newBuyPlan or newSellPlan ? planT2 : na, "Plan TP2", display=display.none)

plot(showEMAs and barstate.isconfirmed ? fastEMA : na, "Fast EMA", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(showEMAs and barstate.isconfirmed ? slowEMA : na, "Slow EMA", color=color.gray, linewidth=2, style=plot.style_linebr)
plot(showRetestZone and barstate.isconfirmed ? buyAnchor : na, "BUY retest anchor", color=color.teal, style=plot.style_linebr)
plot(showRetestZone and barstate.isconfirmed ? sellAnchor : na, "SELL retest anchor", color=color.red, style=plot.style_linebr)
plotshape(showSignals and newBuyPlan, title="BUY plan created", style=shape.labelup, location=location.belowbar, color=color.teal, text="BUY\nPLAN", textcolor=color.white, size=size.tiny)
plotshape(showSignals and newSellPlan, title="SELL plan created", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL\nPLAN", textcolor=color.white, size=size.tiny)
alertcondition(enableAlerts and newBuyPlan, title="Aurum BUY plan", message='Aurum BUY PLAN | {{ticker}} {{interval}} | Entry ref {{plot("Plan Entry")}} | Stop ref {{plot("Plan Stop")}} | TP1 {{plot("Plan TP1")}} | TP2 {{plot("Plan TP2")}} | Pending, not filled. Check broker spread. Demo only.')
alertcondition(enableAlerts and newSellPlan, title="Aurum SELL plan", message='Aurum SELL PLAN | {{ticker}} {{interval}} | Entry ref {{plot("Plan Entry")}} | Stop ref {{plot("Plan Stop")}} | TP1 {{plot("Plan TP1")}} | TP2 {{plot("Plan TP2")}} | Pending, not filled. Check broker spread. Demo only.')
alertcondition(enableAlerts and (newBuyPlan or newSellPlan), title="Aurum ANY plan", message='Aurum PLAN | {{ticker}} {{interval}} | Entry ref {{plot("Plan Entry")}} | Stop ref {{plot("Plan Stop")}} | TP1 {{plot("Plan TP1")}} | TP2 {{plot("Plan TP2")}} | Inspect direction. Pending, not filled. Demo only.')
alertcondition(enableAlerts and triggerObserved, title="Aurum entry level observed", message="Aurum entry level observed | {{ticker}} {{interval}} | chart touch only, NOT a broker fill. Check current plan status and MT5 quote. Demo only.")

f_pass(bool value) => value ? "PASS" : "--"
f_reason(bool ready, bool history, bool quiet, bool trend, bool ema, bool rsi, bool strength, bool trigger, bool atr, bool candleRange, bool distance, bool candle, bool risk, bool room) =>
    not ready ? "Loading data" : not history ? "Missing quiet history" : not trend ? "HTF trends not aligned" : not ema ? "EMA alignment missing" : not rsi ? "RSI outside band" : not strength ? "ADX / DI not aligned" : not trigger ? "Wait for setup trigger" : not atr ? "ATR outside bounds" : not candleRange ? "Signal candle too large" : not distance ? "Price stretched" : not candle ? "Wrong candle direction" : not quiet ? "Quiet period active" : not risk ? "Stop distance invalid" : not room ? "S/R before target 1" : "Rules passed"
string fontSize = panelTextSize == "Tiny" ? size.tiny : panelTextSize == "Normal" ? size.normal : size.small
f_row(table t, int row, string title, string b, string s, string textSize) =>
    table.cell(t, 0, row, title, text_color=chart.fg_color, text_size=textSize)
    table.cell(t, 1, row, b, text_color=chart.fg_color, text_size=textSize)
    table.cell(t, 2, row, s, text_color=chart.fg_color, text_size=textSize)
string panelPosition = switch panelCorner
    "Top right" => position.top_right
    "Top left" => position.top_left
    "Bottom left" => position.bottom_left
    => position.bottom_right
var table panel = table.new(panelPosition, 3, 22, bgcolor=chart.bg_color, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.clear(panel, 0, 0, 2, 21)
    if showPanel
        int k = barstate.isconfirmed ? 0 : 1
        string buyReason = f_reason(dataReady[k], historyReady[k], quietOK[k], trendBuy[k], emaBuy[k], rsiBuy[k], strengthBuy[k], triggerBuy[k], atrOK[k], rangeOK[k], extensionOK[k], candleBuy[k], buyRiskOK[k], buyRoomOK[k])
        string sellReason = f_reason(dataReady[k], historyReady[k], quietOK[k], trendSell[k], emaSell[k], rsiSell[k], strengthSell[k], triggerSell[k], atrOK[k], rangeOK[k], extensionOK[k], candleSell[k], sellRiskOK[k], sellRoomOK[k])
        string directionText = planDirection == 1 ? "BUY" : planDirection == -1 ? "SELL" : "--"
        string timeText = na(signalTime) ? "--" : str.format_time(signalTime, "MM-dd HH:mm", syminfo.timezone)
        string life = planState == 1 ? str.tostring(math.max(0, entryExpiry - (bar_index - planBar))) + " bars left" : planState == 2 ? "Touch, not fill" : "Historical ref"
        f_row(panel, 0, "AURUM PLAN v3", directionText, str.tostring(selectedMinutes) + "m", fontSize)
        f_row(panel, 1, "Status", planStatus, "", fontSize)
        f_row(panel, 2, "Entry ref", f_price(planEntry), life, fontSize)
        f_row(panel, 3, "Stop ref", f_price(planStop), "", fontSize)
        f_row(panel, 4, "TP1 / TP2 ref", f_price(planT1), f_price(planT2), fontSize)
        f_row(panel, 5, "Signal close", timeText, "Exchange TZ", fontSize)
        if panelMode == "Compact"
            f_row(panel, 6, "Next BUY", planState == 1 or planState == 2 ? "Current plan tracked" : buyReason, "", fontSize)
            f_row(panel, 7, "Next SELL", planState == 1 or planState == 2 ? "Current plan tracked" : sellReason, "", fontSize)
            f_row(panel, 8, "Demo references", "Check MT5 spread", "Not win odds", fontSize)
        else
            f_row(panel, 6, setup, "BUY", "SELL", fontSize)
            f_row(panel, 7, "HTF trend", f_pass(trendBuy[k]), f_pass(trendSell[k]), fontSize)
            f_row(panel, 8, "EMA alignment", f_pass(emaBuy[k]), f_pass(emaSell[k]), fontSize)
            f_row(panel, 9, "RSI momentum", f_pass(rsiBuy[k]), f_pass(rsiSell[k]), fontSize)
            f_row(panel, 10, "Setup trigger", f_pass(triggerBuy[k]), f_pass(triggerSell[k]), fontSize)
            f_row(panel, 11, "ADX + DI", requireDMI ? f_pass(strengthBuy[k]) : "OFF", requireDMI ? f_pass(strengthSell[k]) : "OFF", fontSize)
            f_row(panel, 12, "Count (not odds)", str.tostring(visibleBuyCount[k]) + "/" + str.tostring(requiredCount), str.tostring(visibleSellCount[k]) + "/" + str.tostring(requiredCount), fontSize)
            f_row(panel, 13, "ATR / range", f_pass(atrOK[k]), f_pass(rangeOK[k]), fontSize)
            f_row(panel, 14, "Distance / quiet", f_pass(extensionOK[k]), f_pass(quietOK[k]), fontSize)
            f_row(panel, 15, "Stop distance", f_pass(buyRiskOK[k]), f_pass(sellRiskOK[k]), fontSize)
            f_row(panel, 16, "S/R room", useSRRoom ? f_pass(buyRoomOK[k]) : "OFF", useSRRoom ? f_pass(sellRoomOK[k]) : "OFF", fontSize)
            f_row(panel, 17, "Next BUY", buyReason, "", fontSize)
            f_row(panel, 18, "Next SELL", sellReason, "", fontSize)
            f_row(panel, 19, "Current plan", planState == 1 or planState == 2 ? "Blocks new plans" : "No active plan", "", fontSize)
            f_row(panel, 20, "Broker spread", "CHECK MT5", "Unavailable", fontSize)
            f_row(panel, 21, "Demo references", "Not win odds", "No orders", fontSize)
